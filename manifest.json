{
  "manifest_version": 3,
  "name": "AI Code Explainer",
  "version": "1.0",
  "description": "Построчный анализ кода через контекстное меню и скриншоты",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["config.js","background.js"]
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "take-screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Сделать скриншот фрагмента кода"
    }
  }
}