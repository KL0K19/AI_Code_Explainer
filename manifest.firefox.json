{
  "manifest_version": 3,
  "name": "AI Code Explainer",
  "version": "1.0",
  "description": "Построчный анализ кода через контекстное меню и скриншоты",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-code-explainer@local",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "take-screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Сделать скриншот фрагмента кода"
    }
  }
}